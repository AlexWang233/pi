# Copy to .env once. Existing terminal variables override values in this file.
# Paste the provider key here, never in config.local.json or browser chat.
OPENAI_API_KEY=

# These are sign-in passwords for the Alice/Bob demo users, not provider keys.
# Generate two distinct private tokens once, each at least 24 characters long.
# Paste the saved token into the browser's token field to connect as that user.
# node -p "require('node:crypto').randomBytes(24).toString('base64url')"
COLLAB_TOKEN_ALICE=
COLLAB_TOKEN_BOB=

# Relative paths resolve from apps/collab-demo. Choose a fresh data folder
# when changing the fixed agents/models of a previously opened thread.
COLLAB_CONFIG=config.local.json
COLLAB_DATA=data/openai-ollama
COLLAB_PORT=4310

# The default is native OpenAI + local Ollama; start the local Ollama server separately.
# Optional Codex configuration uses cached CLI login; do not paste its auth JSON here.
# Optional overrides:
# CODEX_BIN=codex
# COLLAB_OLLAMA_URL=http://127.0.0.1:11434/v1
