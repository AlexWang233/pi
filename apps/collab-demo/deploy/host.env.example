# systemd EnvironmentFile syntax. Copy outside the checkout; fill values privately, mode 0600.
COLLAB_CONFIG=/etc/pi-collab/config.json
# Keep this path consistent with the unit's mount guard, lock and ReadWritePaths.
COLLAB_DATA=/var/lib/pi-collab
COLLAB_PORT=4310
CODEX_BIN=/opt/codex/bin/codex
OPENAI_API_KEY=
COLLAB_TOKEN_ALICE=
COLLAB_TOKEN_BOB=
# Add other provider keys only when a selected lane needs them.
